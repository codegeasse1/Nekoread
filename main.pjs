$meta
  title = Nexo — AI CHAT and CODING
  description = An expert AI coding assistant with full internet access. Ask about code, debugging, architecture — and it searches the web / reads live pages to verify.
  tags = ai, chat, coding



generateText = {import:ai-text-plugin}
superFetch = {import:super-fetch-plugin}
createServerSocket = {import:server-plugin}

// =============================================================
//  Nexo — AI coding copilot chat with real internet access
//  (web search via DuckDuckGo HTML + page fetching, both CORS-free
//  through the super-fetch-plugin)
// =============================================================

systemPrompt() =>
  let lines = [
    "You are Nexo, a brilliant senior software engineer and coding copilot with full internet access. You write clean, idiomatic, production-ready code, explain things clearly, and debug relentlessly. You have deep knowledge of every major language, framework, and tool, and you stay current.",
    "",
    "You always know today's date and time — every prompt includes a TODAY line with the current date and the user's local time. Never search for the current date, day, or time.",
    "INTERNET ACCESS",
    "You have two web tools for when the answer genuinely needs information you lack: current library versions, API signatures, official docs, error messages, live data, news, prices, events, or anything published recently that you cannot know from memory.",
    "",
    "To run a search, output EXACTLY this and nothing else on its own line:",
    "[[SEARCH:your query here]]",
    "",
    "To read a specific page, output EXACTLY this line:",
    "[[FETCH:https://example.com/page]]",
    "",
    "To show the user images, output EXACTLY this line:",
    "[[IMAGES:subject to search for]]",
    "",
    "Only use a tool when it truly adds value — answering directly is much faster and is your default. When you do use a tool, first output only the marker line, then after the results are returned to you, continue with your answer. You may chain several markers before answering.",
    "When the user explicitly asks to SEE images/pictures/photos of a person, place, or thing (e.g. 'show me images of X'), use [[IMAGES:X]] first — the images are displayed to the user — then briefly describe what was found. Never use [[IMAGES:]] for coding or factual questions; only when the user wants to see pictures.",
    "",
    "RESPONSE STYLE",
    "- Be concise but complete; short correct answers beat walls of text.",
    "- Use fenced code blocks with a language tag for all code.",
    "- When uncertain or unverified, say so plainly. Never invent APIs, versions, or docs.",
    "- Prefer current documentation over memory for anything version-sensitive.",
    "- If the user writes in a non-English language, answer in that same language."
  ];
  return lines.join("\n");

quickInstruction() =>
  return "QUICK MODE IS ON. Answer very fast and terse: no preamble, no filler. Skip web searches unless truly essential. At most one code block. Aim for under ~120 words. Just give the answer.";

chatsKey() =>
  return "nexo_chats_v1";

newChatId() =>
  return "c" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);

saveChats() =>
  try {
    let nx = window.__nexo;
    localStorage.setItem(chatsKey(), JSON.stringify({ chats: nx.chats, activeId: nx.activeId }));
  } catch (e) {
  }

loadChats() =>
  try {
    let raw = localStorage.getItem(chatsKey());
    if (raw) {
      let data = JSON.parse(raw);
      if (data && Array.isArray(data.chats)) {
        window.__nexo.chats = data.chats;
        window.__nexo.activeId = data.activeId || null;
      }
    }
  } catch (e) {
  }

agentState() =>
  if (!window.__nexo) window.__nexo = { chats: [], activeId: null, loaded: false };
  let nx = window.__nexo;
  if (!nx.loaded) {
    nx.loaded = true;
    loadChats();
    if (nx.chats.length === 0) {
      let chat = { id: newChatId(), title: "New chat", createdAt: Date.now(), updatedAt: Date.now(), messages: [], summary: "", compacting: false, currentGen: null };
      nx.chats.push(chat);
      nx.activeId = chat.id;
      saveChats();
    } else if (!nx.activeId || !nx.chats.some(function (c) { return c.id === nx.activeId; })) {
      nx.activeId = nx.chats[nx.chats.length - 1].id;
    }
  }
  return nx.chats.find(function (c) { return c.id === nx.activeId; });

welcomeText() =>
  return "Hi! I'm **Nexo** — your coding copilot with full internet access. Ask me anything about code, debugging, or architecture, and I can search the web or read live pages when I need to verify facts.\n\nTry one of the suggestions below, or just ask. Toggle **Quick** for terse fast answers, or turn **Internet** off to stick to my own knowledge.";

buildPrompt(st, task, toolNotes) =>
  let parts = [];
  parts.push(systemPrompt());
  parts.push("Below is the conversation so far. Follow the TASK at the end.");
  if (st.summary) parts.push("[Summary of earlier messages: " + st.summary + "]");
  for (let msg of st.messages) parts.push(stripGalleryTag(msg));
  if (toolNotes.length > 0) parts.push("TOOL RESULTS:\n" + toolNotes.join("\n\n"));
  parts.push("TODAY: " + todayLine());
  parts.push("TASK: " + task);
  return parts.join("\n\n");

todayLine() =>
  let now = new Date();
  let days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  let months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  let d = days[now.getDay()] + ", " + months[now.getMonth()] + " " + now.getDate() + ", " + now.getFullYear();
  let hh = String(now.getHours()).padStart(2, "0");
  let mm = String(now.getMinutes()).padStart(2, "0");
  return "Current date: " + d + " | Current local time: " + hh + ":" + mm;

dateAnswer(msg) =>
  let m = msg.toLowerCase();
  let now = new Date();
  let days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  let months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  let dayName = days[now.getDay()];
  let dateStr = dayName + ", " + months[now.getMonth()] + " " + now.getDate() + ", " + now.getFullYear();
  let hh = String(now.getHours()).padStart(2, "0");
  let mm = String(now.getMinutes()).padStart(2, "0");
  let wantsDay = /(what day|day is it|day is today|which day|current day|what is today|what's today)/.test(m);
  let wantsDate = /(what date|date is it|today's date|current date|what is the date|what's the date)/.test(m);
  let wantsTime = /(what time|current time|time is it|time now|what's the time|what time is)/.test(m);
  if (!wantsDay && !wantsDate && !wantsTime) return null;
  let parts = [];
  if (wantsDay) parts.push("Today is " + dayName + ".");
  if (wantsDate) parts.push("Today's date is " + dateStr + ".");
  if (wantsTime) parts.push("The current time is " + hh + ":" + mm + ".");
  return { text: parts.join(" ") + "\n\n*Answered instantly — no web search needed for the date.*" };

async maybeCompact(st) =>
  if (st.compacting || st.messages.length <= 8) return;
  let meta = generateText({ getMetaObject: true });
  if (meta.countTokens(buildPrompt(st, "", [])) < meta.idealMaxContextTokens * 0.85) return;
  st.compacting = true;
  try {
    let n = st.messages.length - 8;
    let boundary = st.messages[n - 1].slice(-30);
    let res = await generateText({
      instruction: buildPrompt(st, "Summarize the first " + n + " messages, stopping after the message ending with: \"" + boundary + "\". Fold in the existing summary block if present. Keep names, decisions, code facts, and unresolved threads. Output ONLY the new summary text.", [])
    });
    st.summary = res.text.trim();
    st.messages = st.messages.slice(n);
  } catch (e) {
  } finally {
    st.compacting = false;
  }

// ---- tools ----

async fetchWithTimeout(url, ms) =>
  let ctrl = new AbortController();
  let timer = setTimeout(function () { ctrl.abort(); }, ms || 15000);
  try {
    return await superFetch(url, { signal: ctrl.signal });
  } finally {
    clearTimeout(timer);
  }

async webSearch(q) =>
  let items = [];
  try { items = await braveSearch(q); } catch (e) { items = []; }
  if (items.length === 0) {
    try { items = await bingSearch(q); } catch (e) { items = []; }
  }
  if (items.length === 0) {
    try { items = await mojeekSearch(q); } catch (e) { items = []; }
  }
  if (items.length === 0) return "(No search results found for: " + q + ")";
  return items.slice(0, 6).map(function (it, i) {
    return (i + 1) + ". " + it.title + "\n   URL: " + it.href + (it.snippet ? "\n   " + it.snippet : "");
  }).join("\n\n");

async braveSearch(q) =>
  let url = "https://search.brave.com/search?q=" + encodeURIComponent(q);
  let res = await fetchWithTimeout(url, 28000);
  let doc = new DOMParser().parseFromString(await res.text(), "text/html");
  let items = [];
  doc.querySelectorAll("div.snippet[data-type='web']").forEach(function (sn) {
    let a = sn.querySelector("a.l1");
    let titleEl = sn.querySelector(".title");
    let descEl = sn.querySelector(".generic-snippet .content");
    if (a) {
      items.push({
        title: titleEl ? titleEl.textContent.trim() : a.textContent.trim(),
        href: a.href,
        snippet: descEl ? descEl.textContent.trim() : ""
      });
    }
  });
  return items;

async bingSearch(q) =>
  let url = "https://www.bing.com/search?q=" + encodeURIComponent(q);
  let res = await fetchWithTimeout(url, 28000);
  let doc = new DOMParser().parseFromString(await res.text(), "text/html");
  let items = [];
  doc.querySelectorAll("li.b_algo").forEach(function (li) {
    let a = li.querySelector("h2 a") || li.querySelector("a");
    let p = li.querySelector("p");
    if (a) {
      let href = "";
      let cite = li.querySelector("cite");
      if (cite) {
        href = cite.textContent.trim();
        if (href.indexOf("://") < 0) href = "https://" + href;
        href = href.replace(/\s+›\s+/g, "/").replace(/\.\.\.$/, "");
      }
      if (!href) href = a.href;
      items.push({ title: a.textContent.trim(), href: href, snippet: p ? p.textContent.trim() : "" });
    }
  });
  return items;

async mojeekSearch(q) =>
  let url = "https://www.mojeek.com/search?q=" + encodeURIComponent(q);
  let res = await fetchWithTimeout(url, 25000);
  let doc = new DOMParser().parseFromString(await res.text(), "text/html");
  let items = [];
  doc.querySelectorAll("ul.results-standard a.title, a.title").forEach(function (a) {
    items.push({ title: a.textContent.trim(), href: a.href, snippet: "" });
  });
  doc.querySelectorAll("ul.results-standard p.s, p.s").forEach(function (p, i) {
    if (items[i]) items[i].snippet = p.textContent.trim();
  });
  return items;

async bingImages(q) =>
  let url = "https://www.bing.com/images/search?q=" + encodeURIComponent(q) + "&qft=+filterui:imagesize-large&form=IRFLTR";
  let res = await fetchWithTimeout(url, 28000);
  let doc = new DOMParser().parseFromString(await res.text(), "text/html");
  let out = [];
  doc.querySelectorAll("a.iusc").forEach(function (a) {
    let m = a.getAttribute("m");
    if (!m) return;
    try {
      let j = JSON.parse(m);
      if (j.murl || j.turl) out.push({ src: j.murl || "", thumb: j.turl || "", title: j.t || "", page: j.purl || "" });
    } catch (e) {
    }
  });
  return out;

async imageSearch(q) =>
  let items = [];
  try { items = await bingImages(q); } catch (e) { items = []; }
  return items;

toReadableText(html) =>
  let doc = new DOMParser().parseFromString(html, "text/html");
  ["script", "style", "noscript", "iframe", "svg", "nav", "footer", "form", "button", "input", "select", "option"].forEach(function (sel) {
    doc.querySelectorAll(sel).forEach(function (el) { el.remove(); });
  });
  let out = [];
  doc.body.querySelectorAll("h1,h2,h3,h4,h5,p,li,pre,code,blockquote,td,th,summary").forEach(function (el) {
    let t = (el.innerText || el.textContent || "").trim();
    if (t) out.push(t);
  });
  if (out.length === 0) {
    let t = (doc.body.innerText || "").trim();
    if (t) out.push(t);
  }
  return out.join("\n");

async fetchPage(url) =>
  let res = await fetchWithTimeout(url, 20000);
  let ctype = res.headers.get("content-type") || "";
  let body = await res.text();
  let text;
  let trimmed = body.trim().toLowerCase();
  if (ctype.indexOf("json") >= 0) {
    try { text = JSON.stringify(JSON.parse(body), null, 2); } catch (e) { text = body; }
  } else if (ctype.indexOf("html") >= 0 || trimmed.indexOf("<!doctype html") === 0 || trimmed.indexOf("<html") === 0) {
    text = toReadableText(body);
  } else {
    text = body;
  }
  if (text.length > 14000) text = text.slice(0, 14000) + "\n...(truncated)";
  return text;

// ---- marker protocol ([[SEARCH:q]] / [[FETCH:url]]) ----

parseMarkers(text) =>
  let re = /\[\[(SEARCH|FETCH|IMAGES):([^\]]+)\]\]/g;
  let out = [];
  let m;
  while ((m = re.exec(text)) !== null) out.push({ type: m[1], query: m[2].trim() });
  return out;

displayable(text) =>
  let re = /\[\[(SEARCH|FETCH|IMAGES):[^\]]*\]\]/;
  let m = text.match(re);
  return m ? text.slice(0, m.index) : text;

stripGalleryTag(msg) =>
  return msg.replace(/\n\[\[GALLERY:[\s\S]*?\]\]$/, "");

// ---- agent loop ----

needsSearch(msg) =>
  let m = msg.toLowerCase();
  if (/latest|current version|newest|newly|release date|released|what's new|changelog|version of|updated|update on|deprecat|compatib/.test(m)) return true;
  if (/\bnews\b|recent|this year|this month|headline|announcement/.test(m)) return true;
  if (/price|pricing|cost of|downloads|rating|benchmark/.test(m)) return true;
  if (/\b20\d\d\b/.test(m) && /release|launch|feature|support|versio/.test(m)) return true;
  return false;

needsImages(msg) =>
  let m = msg.toLowerCase();
  if (/(^|[^a-z])(show|see|display|find|get|send|give)( me)? (some |a few |the |3 |few )?(images?|pictures?|photos?|pics?)( of| for| from| showing| about|:)/.test(m)) return true;
  if (/[\s(](images?|pictures?|photos?|pics?)[\s)]+(of|for|from|showing|about)[\s]/.test(m)) return true;
  if (/^(show|display|see|get|find) (me )?(some |a few |the )?(images?|pictures?|photos?|pics?)/.test(m)) return true;
  return false;

buildGalleryHtml(urls) =>
  let clean = function (u) { return String(u || "").replace(/&amp;/g, "&"); };
  let items = urls.slice(0, 8).map(function (u) {
    let src = clean(u.thumb || u.src);
    let href = clean(u.src || u.thumb || u.page);
    return '<a class="gimg" href="' + escapeHtml(href) + '" target="_blank" rel="noopener" title="' + escapeHtml(u.title || "") + '"><img loading="lazy" src="' + escapeHtml(src) + '" alt=""></a>';
  }).join("");
  return '<div class="gallery">' + items + "</div>";

async runAgent(task, handlers) =>
  let st = agentState();
  let toolNotes = [];
  let guard = 0;
  let prefix = "";
  let netOn = window.__nexoNet !== false;
  let quickOn = !!window.__nexoQuick;
  let lastMsg = st.messages.length ? st.messages[st.messages.length - 1] : "";
  let mustSearch = netOn && !quickOn && needsSearch(lastMsg);
  let mustImages = netOn && !quickOn && needsImages(lastMsg);
  while (guard < 5) {
    guard++;
    let curTask = task;
    if (guard === 1 && netOn) curTask = "Reply to the user now. If they asked to SEE images, begin with an [[IMAGES:...]] marker. If they asked for a current/latest version, release date, recent news, or any fact that changes over time, begin with a [[SEARCH:...]] marker. Otherwise answer directly right now.\n\n" + task;
    if (guard > 1) curTask = "Continue your response exactly from where you stopped. Use the TOOL RESULTS in the prompt above. If you still need information you may output another [[SEARCH:...]], [[FETCH:...]] or [[IMAGES:...]] marker. Otherwise give your final answer now.";
    if (quickOn) curTask = curTask + "\n" + quickInstruction();
    let opts = {
      instruction: buildPrompt(st, curTask, netOn ? toolNotes : []),
      onChunk: function (d) { handlers.onStream(displayable(d.fullTextSoFar)); }
    };
    if (prefix) opts.startWith = prefix;
    else if (guard === 1 && mustSearch) opts.startWith = "[[SEARCH:";
    else if (guard === 1 && mustImages) opts.startWith = "[[IMAGES:";
    let p = generateText(opts);
    st.currentGen = p;
    let res = await p;
    st.currentGen = null;
    let full = res.text;
    let disp = displayable(full);
    prefix = disp;
    handlers.onStream(disp);
    let markers = parseMarkers(full);
    if (window.__stopFlag || !netOn || markers.length === 0) break;
    let jobs = markers.slice(0, 3).map(function (mk) {
      handlers.onStatus((mk.type === "SEARCH" ? "Searching" : mk.type === "IMAGES" ? "Fetching images" : "Fetching") + " — " + mk.query);
      return (async function () {
        try {
          if (mk.type === "IMAGES") {
            let urls = await imageSearch(mk.query);
            if (handlers.onImages && urls.length) handlers.onImages(urls);
            if (!urls.length) return "[" + mk.type + ": " + mk.query + "]\n(No images found for that query.)";
            return "[" + mk.type + ": " + mk.query + "]\nFetched " + urls.length + " images — they have been displayed to the user. Briefly describe what these images show. Titles: " + urls.slice(0, 6).map(function (u) { return u.title; }).filter(Boolean).join("; ");
          }
          let result = mk.type === "SEARCH" ? await webSearch(mk.query) : await fetchPage(mk.query);
          return "[" + mk.type + ": " + mk.query + "]\n" + result;
        } catch (e) {
          return "[" + mk.type + ": " + mk.query + "]\n(Error: " + (e && e.message ? e.message : "request failed") + ")";
        }
      })();
    });
    toolNotes.push.apply(toolNotes, await Promise.all(jobs));
  }
  return prefix;

// ---- markdown rendering ----

escapeHtml(s) =>
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

renderInline(txt) =>
  let t = escapeHtml(txt);
  t = t.replace(/`([^`]+)`/g, "<code>$1</code>");
  t = t.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  t = t.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, "$1<em>$2</em>");
  t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  return t;

renderBlock(txt) =>
  let lines = txt.split("\n");
  let html = "";
  let inList = false;
  for (let line of lines) {
    if (/^\s*#+\s/.test(line)) {
      if (inList) { html += "</ul>"; inList = false; }
      let m = line.match(/^#+/);
      let lvl = m ? m[0].length : 1;
      let content = line.replace(/^#+\s*/, "");
      let tag = lvl === 1 ? "h3" : lvl === 2 ? "h4" : "h5";
      html += "<" + tag + ">" + renderInline(content) + "</" + tag + ">";
    } else if (/^\s*[-*]\s+/.test(line)) {
      if (!inList) { html += "<ul>"; inList = true; }
      html += "<li>" + renderInline(line.replace(/^\s*[-*]\s+/, "")) + "</li>";
    } else if (/^\s*>\s?/.test(line)) {
      if (inList) { html += "</ul>"; inList = false; }
      html += "<blockquote>" + renderInline(line.replace(/^\s*>\s?/, "")) + "</blockquote>";
    } else if (/^\s*$/.test(line)) {
      if (inList) { html += "</ul>"; inList = false; }
    } else {
      if (inList) { html += "</ul>"; inList = false; }
      html += "<p>" + renderInline(line.trim()) + "</p>";
    }
  }
  if (inList) html += "</ul>";
  return html;

renderMarkdown(src) =>
  if (!src) return "";
  let out = "";
  let parts = String(src).split("```");
  for (let i = 0; i < parts.length; i++) {
    if (i % 2 === 1) {
      let code = parts[i];
      let lang = "";
      let nl = code.indexOf("\n");
      if (nl >= 0) { lang = code.slice(0, nl).trim(); code = code.slice(nl + 1); }
      lang = lang.replace(/[^a-zA-Z0-9+#\-]/g, "");
      out += "<pre><code" + (lang ? ' class="lang-' + lang + '"' : "") + ">" + escapeHtml(code) + "</code></pre>";
    } else {
      out += renderBlock(parts[i]);
    }
  }
  return out;

// ---- GitHub commit ----

githubStorageKey() =>
  return "nexo_github_v1";

githubLoad() =>
  try {
    let raw = localStorage.getItem(githubStorageKey());
    let d = raw ? JSON.parse(raw) : {};
    return { token: d.token || "", owner: d.owner || "", repo: d.repo || "", branch: d.branch || "main", message: d.message || "" };
  } catch (e) {
    return { token: "", owner: "", repo: "", branch: "main", message: "" };
  }

githubSave(st) =>
  try {
    localStorage.setItem(githubStorageKey(), JSON.stringify(st));
  } catch (e) {
  }

githubFiles() =>
  return ["main.pjs", "index.html", "src/README.md"];

githubRepoPath(st) =>
  return "/repos/" + encodeURIComponent(st.owner) + "/" + encodeURIComponent(st.repo);

githubNormalizeOwnerRepo(st) =>
  let owner = (st.owner || "").trim();
  let repo = (st.repo || "").trim();
  let fromUrl = function (str) {
    let m = str.match(/github\.com\/([A-Za-z0-9_.-]+)(?:\/([A-Za-z0-9_.-]+))?/i);
    return m ? { owner: m[1], repo: m[2] || "" } : null;
  };
  let u = fromUrl(owner);
  if (u) {
    owner = u.owner;
    if (u.repo && !repo) repo = u.repo;
  }
  u = fromUrl(repo);
  if (u) {
    if (u.owner && !owner) owner = u.owner;
    if (u.repo) repo = u.repo;
  }
  owner = owner.replace(/\/+$/, "");
  repo = repo.replace(/\/+$/, "").replace(/\.git$/i, "");
  if (!owner || /^github\.com$/i.test(owner) || owner === "dashboard" || owner === "settings" || /^settings\//i.test(owner) || /^(new|login|signup|explore|features|pricing)$/i.test(owner)) {
    owner = "";
  }
  st.owner = owner;
  st.repo = repo;
  return st;

async githubApi(path, method, body, token) =>
  let headers = {
    "Authorization": "Bearer " + token,
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
  };
  if (body !== undefined) headers["Content-Type"] = "application/json";
  let res = await fetch("https://api.github.com" + path, { method: method || "GET", headers: headers, body: body !== undefined ? JSON.stringify(body) : undefined });
  let text = await res.text();
  let data = null;
  try { data = text ? JSON.parse(text) : null; } catch (e) { }
  if (!res.ok) {
    let msg = (data && data.message) ? data.message : ("HTTP " + res.status);
    throw new Error(msg);
  }
  return data;

bytesToBase64(bytes) =>
  let bin = "";
  let chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
  }
  return btoa(bin);

async githubFileContent(path) =>
  if (path === "main.pjs") {
    let url = "https://perchance.org/api/getGeneratorsAndDependencies?generatorNames=" + encodeURIComponent(window.generatorName);
    let r = await fetch(url);
    let j = await r.json();
    let g = j && j.generators && j.generators[window.generatorName];
    if (!g || g.code === undefined) throw new Error("Could not read main.pjs source");
    return { path: path, content: g.code, encoding: "utf-8" };
  }
  if (path === "index.html") {
    let url = "https://perchance.org/api/getGeneratorHtml?generatorName=" + encodeURIComponent(window.generatorName);
    let r = await root.superFetch(url);
    let text = await r.text();
    return { path: path, content: text, encoding: "utf-8" };
  }
  let r = await fetch(path);
  if (!r.ok) throw new Error("Could not read " + path);
  let bytes = new Uint8Array(await r.arrayBuffer());
  try {
    let text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
    return { path: path, content: text, encoding: "utf-8" };
  } catch (e) {
    return { path: path, content: bytesToBase64(bytes), encoding: "base64" };
  }

async githubCommit(st, onStatus) =>
  if (onStatus) onStatus("Verifying repo…");
  if (!st.owner) {
    let me = await githubApi("/user", "GET", undefined, st.token);
    st.owner = me.login;
  }
  let repoInfo = await githubApi(githubRepoPath(st), "GET", undefined, st.token);
  let branch = st.branch || repoInfo.default_branch || "main";
  let base = null;
  let branchExists = true;
  try {
    let refRes = await githubApi(githubRepoPath(st) + "/git/ref/heads/" + encodeURIComponent(branch), "GET", undefined, st.token);
    base = refRes.object.sha;
  } catch (e) {
    branchExists = false;
  }
  if (!branchExists) {
    let defBranch = repoInfo.default_branch || "main";
    let defExists = true;
    try {
      let defRef = await githubApi(githubRepoPath(st) + "/git/ref/heads/" + encodeURIComponent(defBranch), "GET", undefined, st.token);
      defExists = !!defRef;
    } catch (e2) {
      defExists = false;
    }
    if (defExists && branch !== defBranch) {
      throw new Error("Branch '" + branch + "' not found — this repo's default branch is '" + defBranch + "'.");
    }
    base = null;
  }
  let files = githubFiles();
  let entries = [];
  for (let i = 0; i < files.length; i++) {
    if (onStatus) onStatus("Reading " + files[i] + "…");
    let f = await githubFileContent(files[i]);
    if (onStatus) onStatus("Uploading " + f.path + "…");
    let blob = await githubApi(githubRepoPath(st) + "/git/blobs", "POST", { content: f.content, encoding: f.encoding }, st.token);
    entries.push({ path: f.path, mode: "100644", type: "blob", sha: blob.sha });
  }
  let newTree;
  if (base) {
    if (onStatus) onStatus("Building tree…");
    let curTree = await githubApi(githubRepoPath(st) + "/git/trees/" + encodeURIComponent(base) + "?recursive=1", "GET", undefined, st.token);
    let drop = {};
    files.forEach(function (f) { drop[f] = true; });
    let keep = (curTree.tree || []).filter(function (e) { return e.type === "blob" && !drop[e.path]; }).map(function (e) { return { path: e.path, mode: e.mode, type: e.type, sha: e.sha }; });
    newTree = await githubApi(githubRepoPath(st) + "/git/trees", "POST", { base_tree: curTree.sha, tree: keep.concat(entries) }, st.token);
  } else {
    newTree = await githubApi(githubRepoPath(st) + "/git/trees", "POST", { tree: entries }, st.token);
  }
  if (onStatus) onStatus("Creating commit…");
  let msg = st.message || ("Update from Nexo — " + new Date().toISOString().slice(0, 19).replace("T", " "));
  let commit = await githubApi(githubRepoPath(st) + "/git/commits", "POST", { message: msg, tree: newTree.sha, parents: base ? [base] : [] }, st.token);
  if (base) {
    await githubApi(githubRepoPath(st) + "/git/refs/heads/" + encodeURIComponent(branch), "PATCH", { sha: commit.sha, force: false }, st.token);
  } else {
    await githubApi(githubRepoPath(st) + "/git/refs", "POST", { ref: "refs/heads/" + branch, sha: commit.sha }, st.token);
  }
  return { sha: commit.sha, branch: branch, url: "https://github.com/" + st.owner + "/" + st.repo + "/commit/" + commit.sha };

openGithubModal() =>
  let st = githubNormalizeOwnerRepo(githubLoad());
  githubSave(st);
  document.getElementById("ghOwnerInput").value = st.owner;
  document.getElementById("ghRepoInput").value = st.repo;
  document.getElementById("ghBranchInput").value = st.branch;
  document.getElementById("ghMessageInput").value = st.message;
  document.getElementById("ghTokenInput").value = st.token;
  let status = document.getElementById("ghStatus");
  status.textContent = "";
  status.className = "gh-status";
  document.getElementById("ghResult").innerHTML = "";
  document.getElementById("ghFilesEl").textContent = "Files to commit: " + githubFiles().join(", ");
  document.getElementById("ghModal").hidden = false;
  document.getElementById("ghOwnerInput").focus();

closeGithubModal() =>
  document.getElementById("ghModal").hidden = true;

clearGithubToken() =>
  let st = githubLoad();
  st.token = "";
  githubSave(st);
  document.getElementById("ghTokenInput").value = "";

async doGithubCommit() =>
  let st = githubLoad();
  let inputToken = document.getElementById("ghTokenInput").value.trim();
  if (inputToken) st.token = inputToken;
  st.owner = document.getElementById("ghOwnerInput").value.trim();
  st.repo = document.getElementById("ghRepoInput").value.trim();
  st.branch = document.getElementById("ghBranchInput").value.trim();
  st.message = document.getElementById("ghMessageInput").value.trim();
  githubNormalizeOwnerRepo(st);
  githubSave(st);
  document.getElementById("ghOwnerInput").value = st.owner;
  document.getElementById("ghRepoInput").value = st.repo;
  let status = document.getElementById("ghStatus");
  let result = document.getElementById("ghResult");
  result.innerHTML = "";
  status.className = "gh-status";
  if (!st.token) {
    status.textContent = "Paste a GitHub token first (see the note in this window).";
    status.className = "gh-status error";
    return;
  }
  if (!st.owner) {
    try {
      let me = await githubApi("/user", "GET", undefined, st.token);
      st.owner = me.login;
      githubSave(st);
      document.getElementById("ghOwnerInput").value = st.owner;
    } catch (e) {
      status.textContent = "Couldn't find the owner for this token (" + e.message + ") — type your GitHub username in the Owner field.";
      status.className = "gh-status error";
      return;
    }
  }
  if (!st.owner || !st.repo) {
    status.textContent = "Enter the repo owner and name.";
    status.className = "gh-status error";
    return;
  }
  if (window.generatorIsUnsaved) {
    status.textContent = "You have unsaved changes. The commit pushes the saved version of your generator — save it first (the Save button in the editor), then commit again.";
    status.className = "gh-status error";
    return;
  }
  let btn = document.getElementById("ghCommitBtn");
  btn.disabled = true;
  try {
    let res = await githubCommit(st, function (s) { status.textContent = s; });
    status.textContent = "Done! Branch " + res.branch + " updated → " + res.sha.slice(0, 7);
    status.className = "gh-status ok";
    result.innerHTML = '<a href="' + res.url + '" target="_blank" rel="noopener">Open commit on GitHub ↗</a>';
  } catch (e) {
    status.textContent = "Error: " + (e && e.message ? e.message : String(e));
    status.className = "gh-status error";
  } finally {
    btn.disabled = false;
  }

// ---- UI ----

autoScroll() =>
  let el = window.messagesEl;
  el.scrollTop = el.scrollHeight;

autoResize() =>
  let el = window.chatInput;
  el.style.height = "auto";
  el.style.height = Math.min(el.scrollHeight, 160) + "px";

setBusy(b) =>
  window.__busy = b;
  window.sendBtn.disabled = b;
  window.chatInput.disabled = b;
  window.stopBtn.hidden = !b;

updateHint() =>
  let tag = document.querySelector(".tag");
  if (window.__nexoNet) {
    window.hintEl.textContent = "Internet access on — Nexo can search the web and read pages live.";
    if (tag) tag.textContent = "AI coding copilot · internet on";
  } else {
    window.hintEl.textContent = "Internet access off — answers come from Nexo's own knowledge.";
    if (tag) tag.textContent = "AI coding copilot · internet off";
  }

addUserBubble(text) =>
  let div = document.createElement("div");
  div.className = "row user";
  div.innerHTML = '<div class="bubble"></div>';
  div.firstChild.innerHTML = renderMarkdown(text);
  window.messagesEl.appendChild(div);
  autoScroll();

addBotBubble() =>
  let div = document.createElement("div");
  div.className = "row bot";
  div.innerHTML = '<div class="bubble bot"><div class="avatar">N</div><div class="body"><div class="content"></div><div class="status hidden"><span class="spinner"></span><span class="stext"></span></div><div class="actions"></div></div></div>';
  let status = div.querySelector(".status");
  status.hidden = true;
  window.messagesEl.appendChild(div);
  autoScroll();
  return div;

addActions(bubble, text) =>
  let actions = bubble.querySelector(".actions");
  let copy = document.createElement("button");
  copy.className = "actbtn";
  copy.textContent = "Copy";
  copy.addEventListener("click", async function () {
    try {
      await navigator.clipboard.writeText(text);
      copy.textContent = "Copied";
    } catch (e) {
      copy.textContent = "Error";
    }
    setTimeout(function () { copy.textContent = "Copy"; }, 1600);
  });
  let retry = document.createElement("button");
  retry.className = "actbtn";
  retry.textContent = "Regenerate";
  retry.addEventListener("click", function () { regenerate(); });
  actions.appendChild(copy);
  actions.appendChild(retry);

async generateReply() =>
  window.__stopFlag = false;
  setBusy(true);
  let bubble = addBotBubble();
  let content = bubble.querySelector(".content");
  let status = bubble.querySelector(".status");
  let stext = status.querySelector(".stext");
  content.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
  let curText = "";
  let galleryHtml = "";
  let galleryUrls = [];
  let render = function () {
    content.innerHTML = renderMarkdown(curText) + galleryHtml;
    autoScroll();
  };
  try {
    let finalText = await runAgent("Write the next response as Nexo.", {
      onStream: function (t) {
        status.hidden = true;
        curText = t;
        render();
      },
      onStatus: function (s) {
        stext.textContent = s;
        status.hidden = false;
        autoScroll();
      },
      onImages: function (urls) {
        if (!urls || !urls.length) return;
        galleryUrls = urls;
        galleryHtml = buildGalleryHtml(urls);
        render();
      }
    });
    let st = agentState();
    if ((!finalText || !finalText.trim()) && galleryUrls.length === 0) {
      content.innerHTML = "<p>Generation stopped.</p>";
      return;
    }
    if (!finalText) finalText = "";
    let saved = finalText;
    if (galleryUrls.length) saved = finalText + "\n\n[[GALLERY:" + JSON.stringify(galleryUrls) + "]]";
    st.messages.push("Nexo: " + saved);
    st.updatedAt = Date.now();
    if (finalText.trim()) addActions(bubble, finalText);
    saveChats();
    await maybeCompact(st);
    saveChats();
  } catch (e) {
    content.innerHTML = "<p>Something went wrong: " + escapeHtml(e && e.message ? e.message : String(e)) + "</p>";
  } finally {
    setBusy(false);
  }

async sendMessage() =>
  let input = window.chatInput;
  let msg = input.value.trim();
  if (!msg || window.__busy) return;
  input.value = "";
  autoResize();
  let st = agentState();
  st.messages.push("User: " + msg);
  if (st.title === "New chat") st.title = msg.length > 34 ? msg.slice(0, 34) + "…" : msg;
  st.updatedAt = Date.now();
  saveChats();
  updateChatList();
  addUserBubble(msg);
  let fast = dateAnswer(msg);
  if (fast) {
    let bubble = addBotBubble();
    bubble.querySelector(".content").innerHTML = renderMarkdown(fast.text);
    addActions(bubble, fast.text);
    st.messages.push("Nexo: " + fast.text);
    st.updatedAt = Date.now();
    saveChats();
    return;
  }
  await generateReply();

regenerate() =>
  if (window.__busy) return;
  let st = agentState();
  if (st.messages.length && st.messages[st.messages.length - 1].startsWith("Nexo: ")) st.messages.pop();
  if (!st.messages.length) return;
  generateReply();

newChat() =>
  if (window.__busy) return;
  let nx = window.__nexo;
  let chat = { id: newChatId(), title: "New chat", createdAt: Date.now(), updatedAt: Date.now(), messages: [], summary: "", compacting: false, currentGen: null };
  nx.chats.push(chat);
  nx.activeId = chat.id;
  saveChats();
  renderChat(chat);
  updateChatList();
  closeSidebar();
  window.chatInput.focus();
  autoResize();

deleteChat(id) =>
  if (window.__busy) return;
  let nx = window.__nexo;
  let chat = nx.chats.find(function (c) { return c.id === id; });
  if (!chat) return;
  if (!confirm("Delete this chat? This cannot be undone.")) return;
  nx.chats = nx.chats.filter(function (c) { return c.id !== id; });
  if (nx.activeId === id) {
    if (nx.chats.length === 0) {
      let fresh = { id: newChatId(), title: "New chat", createdAt: Date.now(), updatedAt: Date.now(), messages: [], summary: "", compacting: false, currentGen: null };
      nx.chats.push(fresh);
      nx.activeId = fresh.id;
    } else {
      nx.activeId = nx.chats[nx.chats.length - 1].id;
    }
  }
  saveChats();
  renderChat(agentState());
  updateChatList();

switchChat(id) =>
  if (window.__busy) return;
  let nx = window.__nexo;
  if (id === nx.activeId) { closeSidebar(); return; }
  nx.activeId = id;
  saveChats();
  renderChat(agentState());
  updateChatList();
  closeSidebar();

closeSidebar() =>
  if (window.sidebarEl) window.sidebarEl.classList.remove("open");
  if (window.backdropEl) window.backdropEl.classList.remove("show");

renderChat(chat) =>
  window.messagesEl.innerHTML = "";
  if (!chat || chat.messages.length === 0) {
    let bubble = addBotBubble();
    bubble.querySelector(".content").innerHTML = renderMarkdown(welcomeText());
    autoScroll();
    return;
  }
  for (let msg of chat.messages) {
    if (msg.startsWith("User: ")) {
      addUserBubble(msg.slice(6));
    } else if (msg.startsWith("Nexo: ")) {
      let text = stripGalleryTag(msg.slice(6));
      let bubble = addBotBubble();
      bubble.querySelector(".content").innerHTML = renderMarkdown(text);
      addActions(bubble, text);
      let gm = msg.match(/\n\[\[GALLERY:([\s\S]*?)\]\]$/);
      if (gm) {
        try {
          let urls = JSON.parse(gm[1]);
          if (Array.isArray(urls) && urls.length) {
            bubble.querySelector(".content").insertAdjacentHTML("beforeend", buildGalleryHtml(urls));
          }
        } catch (e) {
        }
      }
    }
  }
  autoScroll();

updateChatList() =>
  let list = window.chatListEl;
  if (!list) return;
  let nx = window.__nexo;
  list.innerHTML = "";
  if (nx.chats.length === 0) {
    list.innerHTML = '<div class="side-empty">No chats yet.</div>';
    return;
  }
  let items = nx.chats.slice().sort(function (a, b) { return (b.updatedAt || 0) - (a.updatedAt || 0); });
  for (let chat of items) {
    let item = document.createElement("div");
    item.className = "chatitem" + (chat.id === nx.activeId ? " active" : "");
    let title = document.createElement("div");
    title.className = "ctitle";
    title.textContent = chat.title || "New chat";
    let del = document.createElement("button");
    del.className = "cdel";
    del.title = "Delete chat";
    del.textContent = "✕";
    del.addEventListener("click", function (e) {
      e.stopPropagation();
      deleteChat(chat.id);
    });
    item.appendChild(title);
    item.appendChild(del);
    item.addEventListener("click", function () { switchChat(chat.id); });
    list.appendChild(item);
  }

initPresence() =>
  if (!window.viewerEl || window.__presenceInit) return;
  window.__presenceInit = true;
  let statusEl = window.viewerEl.querySelector(".vtext");
  let retries = 0;
  let closed = false;
  let setState = function (text, off) {
    statusEl.textContent = text;
    window.viewerEl.classList.toggle("off", !!off);
  };
  let connect = function () {
    if (closed) return;
    setState("connecting…", true);
    let s;
    try {
      s = root.createServerSocket();
    } catch (e) {
      setState("offline", true);
      return;
    }
    let cur = s;
    s.addEventListener("open", function () { retries = 0; });
    s.addEventListener("message", function (ev) {
      let n = parseInt(ev.data, 10);
      if (!isNaN(n)) setState(n + (n === 1 ? " online" : " online"), false);
    });
    s.addEventListener("close", function (ev) {
      if (ev && ev.code === 4403) { closed = true; setState("offline", true); return; }
      setState("reconnecting…", true);
      let delay = Math.min(30000, 1000 * Math.pow(2, retries)) + Math.random() * 400;
      retries++;
      setTimeout(function () { if (cur === s) connect(); }, delay);
    });
  };
  connect();

initApp() =>
  if (!document.getElementById("app") || window.__nexoInit) return;
  window.__nexoInit = true;
  window.__nexoQuick = false;
  window.__nexoNet = true;
  window.__stopFlag = false;
  window.__busy = false;
  window.sendBtn.addEventListener("click", function () { sendMessage(); });
  window.chatForm.addEventListener("submit", function (e) { e.preventDefault(); sendMessage(); });
  window.chatInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });
  window.chatInput.addEventListener("input", function () { autoResize(); });
  window.quickToggle.addEventListener("change", function () {
    window.__nexoQuick = window.quickToggle.checked;
    window.quickWrap.classList.toggle("on", window.__nexoQuick);
  });
  window.netToggle.addEventListener("change", function () {
    window.__nexoNet = window.netToggle.checked;
    window.netWrap.classList.toggle("on", window.__nexoNet);
    updateHint();
  });
  window.sidebarToggleBtn.addEventListener("click", function () {
    window.sidebarEl.classList.toggle("open");
    window.backdropEl.classList.toggle("show", window.sidebarEl.classList.contains("open"));
  });
  window.backdropEl.addEventListener("click", function () { closeSidebar(); });
  window.newChatBtn.addEventListener("click", function () { newChat(); });
  window.sideNewChatBtn.addEventListener("click", function () { newChat(); });
  window.clearBtn.addEventListener("click", function () { deleteChat(agentState().id); });
  window.stopBtn.addEventListener("click", function () {
    window.__stopFlag = true;
    let cur = agentState().currentGen;
    if (cur && cur.stop) cur.stop();
  });
  document.querySelectorAll(".chip").forEach(function (ch) {
    ch.addEventListener("click", function () {
      window.chatInput.value = ch.dataset.q;
      autoResize();
      sendMessage();
    });
  });
  document.getElementById("ghBtn").addEventListener("click", openGithubModal);
  document.getElementById("ghCloseBtn").addEventListener("click", closeGithubModal);
  document.getElementById("ghCommitBtn").addEventListener("click", doGithubCommit);
  document.getElementById("ghTokenClearBtn").addEventListener("click", clearGithubToken);
  document.getElementById("ghModal").addEventListener("click", function (e) {
    if (e.target.id === "ghModal") closeGithubModal();
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && !document.getElementById("ghModal").hidden) closeGithubModal();
  });
  let st = agentState();
  renderChat(st);
  updateChatList();
  window.chatInput.focus();
  autoResize();
  initPresence();
